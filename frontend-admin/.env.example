# URL base de la API del backend Laravel, con el prefijo de versión
# (ver src/utils/api.js). Debe ser ABSOLUTA e incluir `/api/v1`. El valor
# queda horneado en el bundle en `npm run build` → cambiarlo exige rebuild.
#
# Local:      http://localhost:8000/api/v1
# Producción: https://api.<dominio>/api/v1
VITE_API_BASE_URL=http://localhost:8000/api/v1
