# URL base de la API del backend Laravel, incluyendo el prefijo de
# versión (ver frontend/src/utils/api.js). Siempre absoluta: en build
# nativo (Capacitor) no hay servidor local sirviendo el bundle.
VITE_API_BASE_URL=http://localhost:8000/api/v1

# OPCIONAL. URL de la app Gym Web (`gym.<dominio>`). Si se define, la
# pantalla "Registrar mi gimnasio" muestra un enlace directo al panel de
# gimnasio cuando la solicitud está aprobada. Si se omite, solo se muestra
# el texto (sin enlace).
# VITE_GYM_WEB_URL=http://localhost:5175
